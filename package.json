{
  "name": "@capawesome/capacitor-assets",
  "version": "5.0.1",
  "description": "Generate icon and splash screen images for Capacitor apps",
  "homepage": "https://capawesome.io/",
  "author": "Robin Genz <mail@robingenz.dev>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "capacitor-assets": "./bin/capacitor-assets"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --maxWorkers=4",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run prettier -- --write",
    "eslint": "eslint .",
    "prettier": "prettier 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "prettier": "@ionic/prettier-config",
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capawesome-team/capacitor-assets.git"
  },
  "bugs": {
    "url": "https://github.com/capawesome-team/capacitor-assets/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/capawesome-team/"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/capawesome"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "capacitor",
    "capawesome",
    "resources",
    "mobile",
    "native",
    "icon",
    "splash screen"
  ],
  "dependencies": {
    "@ionic/cli-framework-output": "^2.2.8",
    "@ionic/utils-fs": "^3.1.7",
    "@ionic/utils-subprocess": "^2.1.11",
    "@ionic/utils-terminal": "^2.3.5",
    "@trapezedev/project": "^7.1.10",
    "commander": "^14.0.0",
    "kleur": "^4.1.5",
    "sharp": "^0.35.5",
    "tslib": "^2.8.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/yargs": "^17.0.33",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.9.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
